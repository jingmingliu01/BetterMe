{
  "name": "@betterme/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "eval:ai-check": "node scripts/eval-ai-check.mjs",
    "generate:ai-check-contract": "node scripts/generate-ai-check-contract.mjs",
    "validate:ai-check-contract": "node scripts/validate-ai-check-contract.mjs",
    "check:ai-check-contract": "npm run generate:ai-check-contract -- --check && npm run validate:ai-check-contract",
    "test:ai-check": "node scripts/ai-check-logic-test.mjs",
    "audit:prompt-console": "node scripts/audit-prompt-engineering-console.mjs",
    "test:e2e": "npm run build && node scripts/e2e-extension.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "5.4.21"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.57.0"
  }
}
