{
  "manifest_version": 3,
  "name": "BetterMe",
  "description": "Convince the AI before you continue — and it remembers your excuses.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BetterMe"
  },
  "icons": {
    "128": "icon-128.svg"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/expiry-guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "block.html",
        "settings.html",
        "review.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "settings.html"
}
